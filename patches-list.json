{
  "version": "v0.0.5",
  "appNames": {
    "com.pinterest": "Pinterest"
  },
  "patches": [
    {
      "name": "Disable analytics",
      "description": "Stops Pinterest's usage-event and performance uploads, AppsFlyer tracking, Bugsnag crash reports and the recommendations Pinterest publishes to Google Engage. Its switch is on the Privacy page of HushPinterest settings and starts on. Turning it off or pausing HushPinterest lets those uploads run again. In the manifest it also turns off Firebase Analytics, Crashlytics and Performance collection and Google Analytics' ad ID collection, and sets Google's default analytics and ad consent to denied. That part stays until you patch again without this patch. Sign-in, pin requests and Firebase push components are preserved.",
      "category": "Privacy",
      "use": true,
      "dependencies": [
        "BytecodePatch",
        "HushPinterest settings",
        "ResourcePatch"
      ],
      "compatiblePackages": {
        "com.pinterest": [
          "14.38.0",
          "14.25.0"
        ]
      },
      "compatibility": [
        {
          "name": "Pinterest",
          "packageName": "com.pinterest",
          "description": null,
          "appIconColor": 15073315,
          "signatures": [
            "341d6881b1ecf38361fbf8c8fbae0aa516b45375c39ef5e78b161869acc1bcfa"
          ],
          "targets": [
